pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"$Zai","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":111,"indent":0,"parameters":[0,4,0]},{"code":101,"indent":1,"parameters":["Zai",0,0,2,"宰"]},{"code":401,"indent":1,"parameters":["堂上的卷宗摊着，他手边压着一封文书。"]},{"code":401,"indent":1,"parameters":["「你的虫，本县已经进上去了。」"]},{"code":249,"indent":1,"parameters":[{"name":"Fanfare2","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["Zai",0,0,2,"宰"]},{"code":401,"indent":1,"parameters":["「听说在御前，跟各处的虫斗了一场，"]},{"code":401,"indent":1,"parameters":["没有一只斗得过它。」"]},{"code":401,"indent":1,"parameters":["「御前大悦。抚军那边，也得了赏。」"]},{"code":401,"indent":1,"parameters":["他把朱笔搁下，抬眼看你。"]},{"code":401,"indent":1,"parameters":["「本县已嘱过学使。」他顿了顿，"]},{"code":401,"indent":1,"parameters":["「你读了这些年书，"]},{"code":401,"indent":1,"parameters":["也该有个出身 —— 明年去入邑庠罢。」"]},{"code":401,"indent":1,"parameters":["你退出堂去。"]},{"code":401,"indent":1,"parameters":["日头正照在阶前的石狮子上，亮得晃眼。"]},{"code":411,"indent":0,"parameters":[]},{"code":111,"indent":1,"parameters":[8,33]},{"code":101,"indent":2,"parameters":["Zai",0,0,2,"宰"]},{"code":401,"indent":2,"parameters":["堂上坐着一位朱袍的官人，"]},{"code":401,"indent":2,"parameters":["乌纱帽的展脚平伸着，正低头看案上的卷宗。"]},{"code":401,"indent":2,"parameters":["「成名？」他把卷宗合上，「虫呢。」"]},{"code":401,"indent":2,"parameters":["你把铜丝笼捧上去。他掀开一条缝，"]},{"code":401,"indent":2,"parameters":["看了一眼，忽然直起身来。"]},{"code":401,"indent":2,"parameters":["「……青项金翅。」他半晌没说话，"]},{"code":401,"indent":2,"parameters":["「这样的虫，本县还是头一回见。」"]},{"code":401,"indent":2,"parameters":["「限你三日的那桩，销了。」"]},{"code":401,"indent":2,"parameters":["他招手叫过书吏，朱笔落在册子上。"]},{"code":401,"indent":2,"parameters":["笼子被捧进了内堂。"]},{"code":401,"indent":2,"parameters":["你退出堂来，站在阶下，才觉得腿有些软。"]},{"code":401,"indent":2,"parameters":["你捧着空笼子走出去。外头日头正好，"]},{"code":401,"indent":2,"parameters":["照在衙门口那对石狮子上。"]},{"code":126,"indent":2,"parameters":[33,1,0,1]},{"code":121,"indent":2,"parameters":[4,4,0]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["Zai",0,0,2,"宰"]},{"code":401,"indent":2,"parameters":["堂上坐着一位朱袍的官人，"]},{"code":401,"indent":2,"parameters":["乌纱帽的展脚平伸着，正低头看案上的卷宗。"]},{"code":401,"indent":2,"parameters":["「成名？」他把卷宗合上，「虫呢。」"]},{"code":401,"indent":2,"parameters":["你张了张嘴，说不出话来。"]},{"code":401,"indent":2,"parameters":["「限你三日。三日之后，本县再问你一次。」"]},{"code":412,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":2},{"id":2,"name":"守卫","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"$Guard","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Guard",0,0,2,"守卫"]},{"code":401,"indent":0,"parameters":["「站远些。」"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":6,"y":5},{"id":3,"name":"守卫","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"varia