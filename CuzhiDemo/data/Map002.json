Fix":false,"image":{"tileId":0,"characterName":"$Youth","direction":4,"pattern":1,"characterIndex":0},"list":[{"code":111,"indent":0,"parameters":[0,3,0]},{"code":101,"indent":1,"parameters":["Youth",0,0,2,"村中少年"]},{"code":401,"indent":1,"parameters":["「服了，服了。」少年把笼子抱在怀里，"]},{"code":401,"indent":1,"parameters":["「那只虫，真不是凡品。」"]},{"code":411,"indent":0,"parameters":[]},{"code":111,"indent":1,"parameters":[8,33]},{"code":101,"indent":2,"parameters":["Youth",0,0,2,"村中少年"]},{"code":401,"indent":2,"parameters":["「你也养虫？」"]},{"code":401,"indent":2,"parameters":["少年把笼子举起来晃了晃，"]},{"code":401,"indent":2,"parameters":["里头那只青虫昂着头，须子直翘。"]},{"code":401,"indent":2,"parameters":["「这只叫蟹壳青，村东头没一个斗得过它。」"]},{"code":401,"indent":2,"parameters":["他瞥了一眼你怀里的笼子，"]},{"code":401,"indent":2,"parameters":["笑出了声：「就凭那只？拿来试试。」"]},{"code":401,"indent":2,"parameters":["你把笼子放下来。两只虫进了斗盆。"]},{"code":401,"indent":2,"parameters":["你那只好似木鸡，伏在盆底不动。"]},{"code":401,"indent":2,"parameters":["少年拿猪鬃撩它的须，它还是不动。"]},{"code":401,"indent":2,"parameters":["「这也叫虫？」少年笑得更响了。"]},{"code":401,"indent":2,"parameters":["笑声没落，小虫忽然暴起，"]},{"code":401,"indent":2,"parameters":["直扑蟹壳青，一口咬住它的脖颈。"]},{"code":401,"indent":2,"parameters":["蟹壳青挣开，缩到盆角去了。少年一把把它捞出来。"]},{"code":249,"indent":2,"parameters":[{"name":"Victory1","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":2,"parameters":["Youth",0,0,2,"村中少年"]},{"code":401,"indent":2,"parameters":["正笑着，一只鸡从墙根斜刺里冲过来，伸喙便啄。"]},{"code":250,"indent":2,"parameters":[{"name":"Chicken","volume":90,"pitch":100,"pan":0}]},{"code":249,"indent":2,"parameters":[{"name":"Shock1","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":2,"parameters":["Youth",0,0,2,"村中少年"]},{"code":401,"indent":2,"parameters":["你喊都喊不出声。那虫一跃而起，"]},{"code":401,"indent":2,"parameters":["落在鸡冠上，死死叮住不放。"]},{"code":401,"indent":2,"parameters":["鸡甩着头，咯咯乱叫，扑棱着翅膀跑了。"]},{"code":401,"indent":2,"parameters":["少年看得张着嘴，半天没合上。"]},{"code":401,"indent":2,"parameters":["他把虫捉回笼里，再抬眼看你时，眼神已经变了。"]},{"code":121,"indent":2,"parameters":[3,3